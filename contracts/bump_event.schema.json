{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "碰一碰事件与硬件消息（冻结 v1 · 2026-07-22）",
  "description": "三个对象：BumpEvent(POST /bump 入参)、MqttCmd(dev/{id}/cmd 下行)、MqttEvt(dev/{id}/evt 上行)",
  "$defs": {
    "BumpEvent": {
      "type": "object",
      "required": ["uid_a", "uid_b"],
      "properties": {
        "uid_a": {"type": "string", "description": "发起方读到的对方 NTAG213 UID(hex)"},
        "uid_b": {"type": "string"},
        "device_id": {"type": "string", "description": "上报的板子 id，可选"}
      }
    },
    "MqttCmd": {
      "type": "object",
      "required": ["anim"],
      "properties": {
        "anim": {"type": "string", "enum": ["depart", "return", "idle", "match"]},
        "led": {
          "type": "object",
          "properties": {
            "led_rgb": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "pattern": {"type": "string", "enum": ["breath", "pulse", "calm"]},
            "epoch_ms": {"type": "integer"}
          }
        }
      },
      "description": "双板同步：同一条消息发两台，固件按 epoch_ms 对齐相位"
    },
    "MqttEvt": {
      "type": "object",
      "required": ["nfc_uid", "ts"],
      "properties": {
        "nfc_uid": {"type": "string"},
        "ts": {"type": "integer"}
      }
    }
  }
}
